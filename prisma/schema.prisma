// Prisma schema for the AI Build App platform.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum ProjectStatus {
  DRAFT
  PLANNING
  BUILDING
  READY
  PUBLISHED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  planTier       PlanTier  @default(FREE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  projects       Project[]

  @@map("users")
}

/// OAuth / external identity provider links (Google, GitHub, etc.).
/// Not yet wired to a live provider, but modeled now so social login
/// can be added without a schema migration later.
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  slug        String        @unique
  status      ProjectStatus @default(DRAFT)
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages Message[]
  plan     ProjectPlan?
  files    ProjectFile[]
  versions ProjectVersion[]

  @@index([ownerId])
  @@map("projects")
}

/// AI-generated project plan: features, data model, and build order.
/// Regenerated as the builder conversation evolves.
model ProjectPlan {
  id         String   @id @default(cuid())
  projectId  String   @unique
  summary    String
  /// Array of { title: string, description: string }
  features   Json
  /// Array of { name: string, fields: { name, type, description }[] }
  dataModel  Json
  /// Ordered array of build step strings
  buildSteps Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_plans")
}

/// A single generated source file belonging to a project's prototype build.
model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@map("project_files")
}

/// An immutable snapshot of a project's generated files, taken each time
/// code is (re)generated, so earlier prototypes can be restored.
model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  number    Int
  /// Array of { path: string, content: string }
  files     Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, createdAt])
  @@map("project_versions")
}

/// A single turn in a project's AI builder conversation.
model Message {
  id        String      @id @default(cuid())
  projectId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("messages")
}
