// Prisma schema for the AI Build App platform.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum ProjectStatus {
  DRAFT
  PLANNING
  BUILDING
  READY
  PUBLISHED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ReportTargetType {
  CREATOR
  PROJECT
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  username               String?   @unique
  bio                    String?
  /// Where the creator is based. Free-text and self-reported.
  location               String?
  /// Short line describing what they build (their "craft specialty").
  tagline                String?
  /// Longer biography: their journey, inspiration, and why they build.
  story                  String?
  /// How they approach building — tools, process, principles.
  buildProcess           String?
  email                  String    @unique
  emailVerified          DateTime?
  passwordHash           String?
  image                  String?
  planTier               PlanTier  @default(FREE)
  isFoundingMember       Boolean   @default(false)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts         Account[]
  projects         Project[]
  reviews          Review[]
  articles         Article[]
  invitesSent      InviteCode[]     @relation("InvitesSent")
  invitedByCode    InviteCode?      @relation("InviteUsed")
  following        Follow[]         @relation("UserFollowing")
  followers        Follow[]         @relation("UserFollowers")
  collections      Collection[]
  sentMessages     CreatorMessage[] @relation("SentCreatorMessages")
  receivedMessages CreatorMessage[] @relation("ReceivedCreatorMessages")
  reportsFiled     Report[]         @relation("ReportsFiled")
  reportsReceived  Report[]         @relation("ReportsAgainstUser")

  @@map("users")
}

/// One user following a creator, to see their new published work.
model Follow {
  id         String   @id @default(cuid())
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  creator  User @relation("UserFollowers", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([followerId, creatorId])
  @@index([creatorId])
  @@map("follows")
}

/// A creator-curated grouping of their own projects (e.g. a themed set of templates).
model Collection {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@map("collections")
}

/// A question sent to a creator about one of their marketplace listings.
model CreatorMessage {
  id          String    @id @default(cuid())
  projectId   String
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User    @relation("SentCreatorMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User    @relation("ReceivedCreatorMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@map("creator_messages")
}

/// A report against a creator or a marketplace listing, awaiting moderation.
model Report {
  id              String           @id @default(cuid())
  reporterId      String
  targetType      ReportTargetType
  targetUserId    String?
  targetProjectId String?
  reason          String
  details         String?
  status          ReportStatus     @default(OPEN)
  createdAt       DateTime         @default(now())

  reporter      User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser    User?    @relation("ReportsAgainstUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetProject Project? @relation(fields: [targetProjectId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetUserId])
  @@index([targetProjectId])
  @@index([status])
  @@map("reports")
}

/// A single-use invite code a user can generate and share. Redeeming one at
/// signup marks the new account as a founding member.
model InviteCode {
  id              String    @id @default(cuid())
  code            String    @unique
  createdByUserId String
  usedByUserId    String?   @unique
  createdAt       DateTime  @default(now())
  usedAt          DateTime?

  createdBy User  @relation("InvitesSent", fields: [createdByUserId], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsed", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@map("invite_codes")
}

/// OAuth / external identity provider links (Google, GitHub, etc.).
/// Not yet wired to a live provider, but modeled now so social login
/// can be added without a schema migration later.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  /// OAuth access token for provider APIs (e.g. pushing to GitHub on the
  /// user's behalf). Plaintext for now — production should encrypt at rest.
  accessToken       String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Project {
  id                  String        @id @default(cuid())
  name                String
  description         String?
  slug                String        @unique
  status              ProjectStatus @default(DRAFT)
  ownerId             String
  listedInMarketplace Boolean       @default(false)
  category            String?
  viewCount           Int           @default(0)
  collectionId        String?
  clonedFromId        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collection      Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  clonedFrom      Project?         @relation("ProjectClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones          Project[]        @relation("ProjectClones")
  messages        Message[]
  plan            ProjectPlan?
  files           ProjectFile[]
  versions        ProjectVersion[]
  reviews         Review[]
  creatorMessages CreatorMessage[]
  reports         Report[]

  @@index([ownerId])
  @@index([listedInMarketplace])
  @@index([collectionId])
  @@index([clonedFromId])
  @@map("projects")
}

/// A rating + optional comment left by a user on a marketplace listing.
model Review {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("reviews")
}

/// AI-generated project plan: features, data model, and build order.
/// Regenerated as the builder conversation evolves.
model ProjectPlan {
  id         String   @id @default(cuid())
  projectId  String   @unique
  summary    String
  /// Array of { title: string, description: string }
  features   Json
  /// Array of { name: string, fields: { name, type, description }[] }
  dataModel  Json
  /// Ordered array of build step strings
  buildSteps Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_plans")
}

/// A single generated source file belonging to a project's prototype build.
model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@map("project_files")
}

/// An immutable snapshot of a project's generated files, taken each time
/// code is (re)generated, so earlier prototypes can be restored.
model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  number    Int
  /// Array of { path: string, content: string }
  files     Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, createdAt])
  @@map("project_versions")
}

/// A single turn in a project's AI builder conversation.
model Message {
  id        String      @id @default(cuid())
  projectId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("messages")
}

/// A community-contributed educational article. Supports citations so
/// original sources can be credited rather than presented as the author's own.
model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  /// Array of { text: string, url?: string }
  citations Json     @default("[]")
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("articles")
}
