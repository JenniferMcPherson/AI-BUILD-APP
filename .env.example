# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/ai_build_app?schema=public"

# Secret key used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Anthropic API key. Required for the AI builder to generate real responses.
# Without it, the AI builder chat still works but returns a message explaining
# that AI responses are not yet enabled.
ANTHROPIC_API_KEY=""

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth App credentials, used for the "Export to GitHub" feature.
# Create one at https://github.com/settings/applications/new with callback
# URL "<NEXT_PUBLIC_APP_URL>/api/integrations/github/callback".
# Without these, GitHub export shows as "not set up" instead of erroring.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe billing. Without STRIPE_SECRET_KEY, pricing/upgrade buttons show a
# "billing isn't configured yet" message instead of erroring.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_BUSINESS=""

# Set to "true" to require a valid invite code to sign up. Existing users can
# always generate invite codes from Settings regardless of this flag.
INVITE_ONLY="false"
